---
interface Props {
  logo: string;
  title: string;
}

const { logo, title } = Astro.props;
console.log(title);
---

<a
  href={`/${title}`}
  class="m-1 rounded-md w-full h-[35vh] flex flex-col items-center justify-evenly bg-white shadow-md hover:shadow-2xl transition-shadow duration-300 ease-in-out"
>
  <div class="flex flex-col items-center w-full h-full">
    <div
      class="flex justify-center items-center w-full h-full"
      transition:name=`proyect-${title}`
    >
      <img src={logo} class="object-contain w-full h-full" />
    </div>
  </div>
</a>
