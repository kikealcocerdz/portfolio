---
import Headline from "../components/Headline.astro";
import SocialMedia from "./SocialMedia.astro";
---

<section
  class="flex flex-row justify-center items-center w-full herosection h-full sm:p-20 p-6"
>
  <div
    class="flex sm:flex-row flex-col items-center bg-gray-50 border-[#FFD369] border-4 p-8 rounded-lg shadow-lg max-w-max sm:max-w-6xl mx-auto"
  >
    <img
      src="./enriquemii.png"
      alt="Enrique Alcocer"
      class="mb-6 sm:w-1/2 w-1/2"
    />
    <div class="text-center">
      <h3 class="text-4xl font-regular text-black mb-4">¡Hello there!</h3>
      <p
        class="text-black leading-relaxed sm:text-lg text-sm text-justify sm:px-10"
      >
        Soy un desarrollador freelance madrileño con una pasión innata por la
        tecnología y las experiencias digitales. Combino mis habilidades
        técnicas como Ingeniero Informático con un enfoque creativo para diseñar
        soluciones únicas y funcionales, desde tiendas online hasta sitios web
        interactivos y tradicionales.
        <br /><br />
        Fan de la NBA, los videojuegos, el cine, y el arte, además de pasión por
        comunicar y transmitir ideas, en este caso, desde la Web, lo que me permite
        colaborar de forma cercana y asegurarnos de que cada detalle de tu proyecto
        cuente. Si buscas alguien que combine técnica, creatividad y pasión, ¡estoy
        aquí para ayudarte a hacer realidad tus ideas!
      </p>
    </div>
  </div>
</section>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  document.addEventListener("astro:page-load", () => {
    const t1 = gsap.timeline({
      scrollTrigger: {
        trigger: ".heroImage",
        start: "top 20%",
        end: "bottom 20%",
        scrub: true,
      },
    });
    t1.to(".heroImage", {
      scale: 0.3,
      x: window.innerWidth / 2 - 50,
      y: -55,
      margin: 0,
    });
    t1.to(
      ".animated-name-1",
      {
        opacity: 0,
      },
      "<"
    );
    t1.to(
      ".animated-name-11",
      {
        opacity: 0,
      },
      0
    );
    t1.to(
      ".headerHero",
      {
        opacity: 1,
      },
      0
    );
    t1.set(".heroImage", {
      position: "fixed",
      top: "0px",
      opacity: 1,
      duration: 5,
      zIndex: 100,
    });
  });
  document.addEventListener("astro:after-preparation", () => {
    const t1 = gsap.timeline({
      scrollTrigger: {
        trigger: ".heroImage",
        start: "top 20%",
        end: "bottom 20%",
        scrub: true,
      },
    });
    t1.to(".heroImage", {
      scale: 0.3,
      x: window.innerWidth / 2 - 50,
      y: -55,
      margin: 0,
    });
    t1.to(
      ".animated-name-1",
      {
        opacity: 0,
      },
      "<"
    );
    t1.to(
      ".animated-name-11",
      {
        opacity: 0,
      },
      0
    );
    t1.to(
      ".headerHero",
      {
        opacity: 1,
      },
      0
    );
    t1.set(".heroImage", {
      position: "fixed",
      top: "0px",
      opacity: 1,
      duration: 5,
      zIndex: 100,
    });
  });
</script>
